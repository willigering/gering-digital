# Project URLs: /subnet-sprint/ and relative HTML/CSS/JS/assets.
Options -Indexes
RewriteEngine On
# HTTPS erzwingen: Unter http:// (Port 80) setzt der Browser kein sicheres Session-Cookie,
# dann scheitern Anmeldung und CSRF-Prüfung. STRATO: Port-Prüfung statt %{HTTPS}.
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Never expose private databases, learner data or API credentials, even if data/.htaccess is missing.
RewriteRule ^data(?:/|$) - [F,L,NC]
RewriteRule ^__preview/([a-z0-9][a-z0-9-]{2,59})/?$ admin/html_preview.php?slug=$1 [L,QSA]
RewriteRule ^__preview/([a-z0-9][a-z0-9-]{2,59})/(.+)$ admin/html_preview.php?slug=$1&file=$2 [L,QSA]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^([a-z0-9][a-z0-9-]{2,59})/?$ html_project.php?slug=$1 [L,QSA]
RewriteRule ^([a-z0-9][a-z0-9-]{2,59})/(.+)$ html_project.php?slug=$1&file=$2 [L,QSA]

# Browser merkt sich HTTPS für ein Jahr und versucht http:// gar nicht erst.
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{SERVER_PORT} == 443"
</IfModule>
