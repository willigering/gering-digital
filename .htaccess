# Project URLs: /subnet-sprint/ and relative HTML/CSS/JS/assets.
Options -Indexes -MultiViews
RewriteEngine On
# HTTPS erzwingen: Unter http:// (Port 80) setzt der Browser kein sicheres Session-Cookie,
# dann scheitern Anmeldung und CSRF-Prüfung. Umgeleitet wird nur, wenn keines der Signale
# für HTTPS vorliegt (HTTPS-Variable, X-Forwarded-Proto, Port 443): schützt vor Umleitungsschleifen.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteCond %{SERVER_PORT} !^443$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Never expose private databases, learner data or API credentials, even if data/.htaccess is missing.
RewriteRule ^data(?:/|$) - [F,L,NC]
RewriteRule ^__preview/([a-z0-9][a-z0-9-]{2,59})/?$ admin/html_preview.php?slug=$1 [L,QSA]
RewriteRule ^__preview/([a-z0-9][a-z0-9-]{2,59})/(.+)$ admin/html_preview.php?slug=$1&file=$2 [L,QSA]
# Serve protected lesson HTML only through the learner-session check.
RewriteRule ^dau-to-pro/(unterricht/(csharp-aufgaben|csharp-bedingungen-t05|it-vi-01|itil-recht)|support-serviceanfragen)\.html(?:/.*)?$ dau-to-pro/material-file.php [L,NC]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^([a-z0-9][a-z0-9-]{2,59})/?$ html_project.php?slug=$1 [L,QSA]
RewriteRule ^([a-z0-9][a-z0-9-]{2,59})/(.+)$ html_project.php?slug=$1&file=$2 [L,QSA]

# Browser merkt sich HTTPS für ein Jahr und versucht http:// gar nicht erst.
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000" "expr=%{SERVER_PORT} == 443"
</IfModule>

# Statische Dateien länger im Browser-Cache halten (Spiel-Assets: Musik, Bilder, Schriften).
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType audio/mpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType font/woff2 "access plus 30 days"
ExpiresByType font/ttf "access plus 30 days"
ExpiresByType application/x-font-ttf "access plus 30 days"
</IfModule>

# Textdateien komprimiert ausliefern.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json
</IfModule>
