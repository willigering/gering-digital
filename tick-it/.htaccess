# Only the entry points and two static assets are web-accessible.
Options -Indexes
DirectoryIndex index.php
RewriteEngine On
# HTTPS erzwingen: Unter http:// (Port 80) setzt der Browser kein sicheres Session-Cookie,
# dann scheitern Anmeldung und CSRF-Prüfung. STRATO: Port-Prüfung statt %{HTTPS}.
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^(?!$|index\.php$|api\.php$|version\.php$|setup\.php$|assets/(?:app\.js|styles\.css|update-notice\.js)$) - [F,L,NC]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
</IfModule>
