# Only the entry points and two static assets are web-accessible.
Options -Indexes
DirectoryIndex index.php
RewriteEngine On
# HTTPS erzwingen: Unter http:// (Port 80) setzt der Browser kein sicheres Session-Cookie,
# dann scheitern Anmeldung und CSRF-Prüfung. Umgeleitet wird nur, wenn keines der Signale
# für HTTPS vorliegt (HTTPS-Variable, X-Forwarded-Proto, Port 443): schützt vor Umleitungsschleifen.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteCond %{SERVER_PORT} !^443$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule ^(?!$|index\.php$|api\.php$|version\.php$|setup\.php$|assets/(?:app\.js|styles\.css|update-notice\.js)$) - [F,L,NC]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
</IfModule>
