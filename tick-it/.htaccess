# Only the entry points and two static assets are web-accessible.
Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(?!$|index\.php$|api\.php$|setup\.php$|assets/(?:app\.js|styles\.css)$) - [F,L,NC]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
</IfModule>
