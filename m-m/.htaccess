# Passwortschutz fuer das Testspiel (Basic-Auth ohne .htpasswd, weil der Deploy diese Datei nicht hochlaedt).
RewriteEngine On
# HTTPS erzwingen: Unter http:// (Port 80) setzt der Browser kein sicheres Session-Cookie,
# dann scheitern Anmeldung und CSRF-Prüfung. STRATO: Port-Prüfung statt %{HTTPS}.
RewriteCond %{SERVER_PORT} ^80$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{HTTP:Authorization} !^Basic\ d2lsbGk6TU0xNzU0$
RewriteCond %{ENV:REDIRECT_HTTP_AUTHORIZATION} !^Basic\ d2lsbGk6TU0xNzU0$
RewriteRule ^ - [R=401,L]
Header always set WWW-Authenticate 'Basic realm="Mila und Maja"' "expr=%{REQUEST_STATUS} == 401"
